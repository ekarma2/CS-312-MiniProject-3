<%- include('header', { title: 'Feed' }) %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h2 m-0">Blog Feed</h1>
    <a href="/posts/new" class="btn btn-primary">+ New Post</a>
</div>

<% if (posts.length === 0) { %>
    <p class="text-muted">No posts yet. Be the first to write one!</p>
<% } %>

<!--Posts come from the database already sorted newest first-->
<div class="row g-3">
    <% posts.forEach(post => { %>
        <div class="col-12 col-lg-6">
            <div class="card post-card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <!--Post Content-->
                    <h2 class="h4 card-title"><%= post.title %></h2>
                    <p class="text-muted small mb-2">
                        By <strong><%= post.creator_name %></strong> (@<%= post.creator_user_id %>)
                        &middot; <%= post.date_created.toLocaleString() %>
                        <% if (post.date_updated) { %>
                            &middot; edited <%= post.date_updated.toLocaleString() %>
                        <% } %>
                    </p>
                    <p class="post-body flex-grow-1"><%= post.body %></p>

                    <!--Edit and delete only for the post's creator-->
                    <% if (user && user.user_id === post.creator_user_id) { %>
                        <div class="d-flex gap-2">
                            <a href="/posts/<%= post.blog_id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form action="/posts/<%= post.blog_id %>/delete" method="POST" class="m-0"
                                  onsubmit="return confirm('Delete this post permanently?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    <% }) %>
</div>

<%- include('footer') %>
