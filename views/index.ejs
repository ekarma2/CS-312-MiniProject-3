<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Blog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<%- include('header') %>
<div class="container">
    <a href="/posts/new" class="btn btn-primary mb-4">+ New Post</a>
    <% posts.forEach(post => { %>
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="card-title h4"><%= post.title %></h2>
                <h6 class="card-subtitle mb-2 text-muted">By <%= post.creator_name %></h6>
                <p class="card-text" style="white-space: pre-wrap;"><%= post.body %></p>
                <p class="text-muted small mb-3">
                    Created: <%= post.date_created.toLocaleString() %>
                    <% if (post.date_updated) { %> · Edited: <%= post.date_updated.toLocaleString() %><% } %>
                </p>
                <% if (user && user.user_id === post.creator_user_id) { %>
                    <a href="/posts/<%= post.blog_id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form action="/posts/<%= post.blog_id %>/delete" method="POST" class="d-inline"
                          onsubmit="return confirm('Delete this post?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                <% } %>
            </div>
        </div>
    <% }) %>
</div>
</body>
</html>
