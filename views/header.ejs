<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= typeof title !== 'undefined' ? title + ' | My Blog' : 'My Blog' %></title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom styles -->
    <link href="/styles.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
        <div class="container">
            <a href="/" class="navbar-brand fs-3 fw-bold">My Blog</a>
            <!--Show who is signed in, or links to sign in / sign up-->
            <div class="d-flex align-items-center gap-2">
                <% if (user) { %>
                    <span class="text-light d-none d-sm-inline me-2">Hi, <%= user.name %></span>
                    <form action="/signout" method="POST" class="m-0">
                        <button type="submit" class="btn btn-sm btn-outline-light">Sign Out</button>
                    </form>
                <% } else { %>
                    <a href="/signin" class="btn btn-sm btn-outline-light">Sign In</a>
                    <a href="/signup" class="btn btn-sm btn-light">Sign Up</a>
                <% } %>
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        <!--One-time message (ex: account created, not allowed to edit)-->
        <% if (message) { %>
            <div class="alert alert-info"><%= message %></div>
        <% } %>
