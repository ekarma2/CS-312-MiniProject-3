<nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container d-flex flex-wrap justify-content-between align-items-center">
        <a href="/" class="navbar-brand fs-2 mb-0">My Blog</a>
        <div class="d-flex align-items-center gap-2">
            <% if (user) { %>
                <span class="text-white me-2">Signed in as <%= user.name %></span>
                <form action="/signout" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-light">Sign Out</button>
                </form>
            <% } else { %>
                <a href="/signin" class="btn btn-sm btn-outline-light">Sign In</a>
                <a href="/signup" class="btn btn-sm btn-light">Sign Up</a>
            <% } %>
        </div>
    </div>
</nav>
